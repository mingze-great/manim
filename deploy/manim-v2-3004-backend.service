[Unit]
Description=Manim V2 3004 Backend
After=network.target redis.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/manim-v2-3004-snapshot/backend
ExecStart=/root/miniconda3/envs/manim311/bin/python3.11 -m uvicorn app.main:app --host 0.0.0.0 --port 8004
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=AI_VIDEO_RENDER_SERVICE_URL=http://127.0.0.1:18788
Environment=AI_VIDEO_BACKEND_PUBLIC_URL=http://127.0.0.1:8004
Environment=SC1_MATERIAL_PUBLIC_BASE_URL=http://127.0.0.1:18788/sc1-materials
Environment=AI_VIDEO_COSYVOICE_TIMEOUT=180
Environment=SC1_COSYVOICE_PROMPT_WAV=/opt/manim-v2-3004-snapshot/outputs/cosyvoice_zero_shot_sample.wav

[Install]
WantedBy=multi-user.target
