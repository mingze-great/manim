[Unit]
Description=Manim V2 3004 Backend
After=network.target redis.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/manim-v2-3004-snapshot/backend
ExecStart=/root/miniconda3/envs/manim311/bin/python3.11 -m uvicorn app.main:app --host 0.0.0.0 --port 8004
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
