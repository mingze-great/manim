[Unit]
Description=Manim V2 3003 AI Video Remotion Renderer
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/manim-v2-3003-snapshot/video-render-service/remotion-mind-video
Environment=NODE_ENV=production
Environment=PORT=18787
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
